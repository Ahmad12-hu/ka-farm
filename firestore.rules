rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fonction helper : utilisateur authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fonction helper : vérifie le rôle dans le token JWT
    function hasRole(role) {
      return isAuthenticated()
        && request.auth.token.role == role;
    }

    // Vérifie que l'utilisateur possède l'un des rôles donnés (valeurs réelles des tokens JWT
    // définies dans js/constants/roles.js : 'admin', 'super_admin', 'Bureau', 'Terrain')
    function hasAnyRole(...roles) {
      return isAuthenticated()
        && roles.some(role => request.auth.token.role == role);
    }

    // Fonction helper : vérifie que l'utilisateur accède à son propre entreprise
    function isInSameEnterprise(enterpriseId) {
      return isAuthenticated()
        && request.auth.token.enterpriseId == enterpriseId;
    }

    // Collection des utilisateurs (pour les rôles)
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // écriture réservée au backend/admin
    }

    // Données de l'application - Structure multi-tenant :
    // app_data/{enterpriseId}/{collection}/data
    match /app_data/{enterpriseId}/{collection=**} {
      // Lecture : utilisateur authentifié du même entreprise
      allow read: if isAuthenticated() && isInSameEnterprise(enterpriseId);

      // Écriture : Admin, Super Admin ou Bureau du même entreprise
      allow write: if isAuthenticated()
        && isInSameEnterprise(enterpriseId)
        && hasAnyRole('admin', 'super_admin', 'Bureau');
    }

    // Bloque tout accès autre par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
